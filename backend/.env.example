# Copiar este archivo como ".env" y completar con los valores reales.
# El archivo ".env" nunca se sube a git (ver .gitignore).

DB_SERVER=localhost
DB_PORT=1433
DB_NAME=GestorStockPC
DB_USER=sa
DB_PASSWORD=CAMBIAR_ESTA_CLAVE
DB_DRIVER=ODBC Driver 17 for SQL Server

# Clave para firmar tokens JWT. Generar una propia, por ejemplo con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CAMBIAR_ESTE_SECRETO
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Usuario admin que crea el script de inicialización (scripts/init_db.py)
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@empresa.com
ADMIN_PASSWORD=CAMBIAR_ESTA_CLAVE

# Contraseña por defecto para los usuarios técnicos de ejemplo (scripts/seed_data.py)
SEED_TECNICO_PASSWORD=CAMBIAR_ESTA_CLAVE

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:8100,http://localhost:4200
